# Copy to .env (gitignored) and fill in real values — or set these as
# GitHub Actions secrets / your shell environment directly.
#
# Flyway is JDBC-based, so the URL format is different from the libpq-style
# connection strings used elsewhere in this project (Go/psql use
# postgresql://user:pass@host/db?params — Flyway needs jdbc:postgresql://host/db?params,
# with user/password passed separately below, not embedded in the URL).

FLYWAY_URL=jdbc:postgresql://<host>/<database>?sslmode=require
FLYWAY_USER=neondb_owner
FLYWAY_PASSWORD=

# Note: if your connection string includes channel_binding=require (NeonDB sometimes
# adds this), double check the PostgreSQL JDBC driver version in use actually supports
# it as a URL parameter before relying on it — verify rather than assume.
